# Xcollector bot 配置模板
# 复制成 .env 后按需修改：Copy-Item .env.example .env
# 所有项都有默认值，.env 不存在时服务照样能起来（方便先做"无 NapCat / 无后端"的自检）。

# ---- OneBot 连接 ----
# client=本服务主动连 NapCat 的 WS 地址；server=等服务监听端口，NapCat 反向连过来
ONEBOT_MODE=client
# 仅 client 模式使用：NapCat 的 WebSocket 服务地址
ONEBOT_WS_URL=ws://127.0.0.1:3001
# NapCat 那边配的 access token，两边要一致；留空表示不校验
ONEBOT_ACCESS_TOKEN=
# 仅 server 模式使用：反向 WS 的监听地址/端口/路径
ONEBOT_LISTEN_HOST=0.0.0.0
ONEBOT_LISTEN_PORT=8081
ONEBOT_LISTEN_PATH=/onebot/ws
# 合并转发递归展开的最大深度。上限是为了防"转发套转发"把内存吃光
FORWARD_MAX_DEPTH=3

# ---- 本服务监听（后端会调这些接口）----
# 注意：这是 bot 自己的 HTTP 端口，和上面的 ONEBOT_LISTEN_PORT(8081) 是两个不同的端口
BOT_LISTEN_HOST=127.0.0.1
BOT_LISTEN_PORT=8082
# 后端调 /api/* 时要带的 Bearer token；留空=不校验（仅本地开发，启动时会打 WARNING）
BOT_API_TOKEN=

# ---- 后端 ----
BACKEND_BASE_URL=http://127.0.0.1:8000
# 调后端时带的 Bearer token；留空=不带 Authorization 头
BACKEND_API_TOKEN=
# 单次 HTTP 请求超时（秒）
BACKEND_TIMEOUT=15
# 转发消息给后端失败后的重试次数（不含首次尝试），退避 1s/2s/4s
BACKEND_MAX_RETRIES=3

# ---- 指令 ----
COMMAND_PREFIX=/
# 允许发指令的 QQ 号，格式 id:备注,id:备注（备注可省略）。留空=谁都不能发指令
COMMAND_WHITELIST=
# /add 需要二次确认时的挂起状态存活时间（秒）
PENDING_TTL_SECONDS=600

# ---- 日志 ----
LOG_LEVEL=INFO
# 消息日志里原文预览的最大长度
LOG_PREVIEW_CHARS=60

# Xcollector bot 配置模板
# 复制成 .env 后按需修改：Copy-Item .env.example .env
# 所有项都有默认值，.env 不存在时服务照样能起来（方便先做"无 NapCat / 无后端"的自检）。
#
# 拆分之后，**所有业务开关都在 bot 这一侧**：后端只剩存储，不认识 OneBot、白名单、
# LLM、digest 这些词。所以这个文件比后端那个长，这是正常的。

# ---- OneBot 连接 ----
# client=本服务主动连 NapCat 的 WS 地址；server=等服务监听端口，NapCat 反向连过来
ONEBOT_MODE=client
# 仅 client 模式使用：NapCat 的 WebSocket 服务地址
ONEBOT_WS_URL=ws://127.0.0.1:3001
# NapCat 那边配的 access token，两边要一致；留空表示不校验
ONEBOT_ACCESS_TOKEN=
# 仅 server 模式使用：反向 WS 的监听地址/端口/路径
ONEBOT_LISTEN_HOST=0.0.0.0
ONEBOT_LISTEN_PORT=8081
ONEBOT_LISTEN_PATH=/onebot/ws
# 合并转发递归展开的最大深度。上限是为了防"转发套转发"把内存吃光
FORWARD_MAX_DEPTH=3

# ---- 本服务监听（前端 /api/status 也读这里）----
# 注意：这是 bot 自己的 HTTP 端口，和上面的 ONEBOT_LISTEN_PORT(8081) 是两个不同的端口
BOT_LISTEN_HOST=127.0.0.1
BOT_LISTEN_PORT=8082
# ---- 令牌（见 app/auth.py）----
#
# API_TOKEN —— **服务令牌**。只有 bot 有，也**不要给浏览器、不要给用户**。
#   用途一：调后端时带的 Bearer（后端认它是"bot"：按用户的接口必须再显式带 user_id）。
#   用途二：调 bot 自己的 /api/* 时带的 Bearer；也可以用 BOT_API_TOKEN 单独覆盖
#          （留空就用 API_TOKEN，少配一个密钥就少一处配错的机会）。
#
# 用户拿的不是这个令牌，而是各自注册后拿到的 UserToken（xc_ 开头）。
# 那个只能调后端，调不了 bot 的 /api/* —— 因为 /api/status 是运营者视角
# （里面是所有人的盲区计数和 OneBot 连接状态）。
#
#   生成：python -c "import secrets;print(secrets.token_hex(32))"
API_TOKEN=
# 想给 bot 单独一个管理令牌时填这里；留空则用上面的 API_TOKEN
BOT_API_TOKEN=

# ---- 后端（纯数据层）----
BACKEND_BASE_URL=http://127.0.0.1:8000
# 单次 HTTP 请求超时（秒）
BACKEND_TIMEOUT=15
# 写接口失败后的重试次数（不含首次尝试），退避 1s/2s/4s
BACKEND_MAX_RETRIES=3
# 连原文都没写进后端的消息，放内存待重试队列的上限 / 扫描周期 / 最大尝试次数
PENDING_WRITE_MAX=200
PENDING_RETRY_INTERVAL=60
PENDING_RETRY_MAX_ATTEMPTS=5

# ---- 群 / 发送者白名单 ----
# **两个都是白名单，留空 = 谁都不放行。** bot 只处理同时满足
# 「群在 GROUP_WHITELIST」且「发送者在 SENDER_WHITELIST」的消息，
# 其余的在写库之前就被丢掉 —— 群里不进后端，库里也不留痕。
#
# 为什么默认关死：这套东西只该处理你明确列出来的官方通知群和发布者。
# 留空放开等于"随便哪个群、群里随便谁说话都入库"，那不是它的用途。
# 没配好时启动日志会明确警告「会忽略所有消息」。
#
# 格式：id:备注,id:备注（备注可省略）
GROUP_WHITELIST=
SENDER_WHITELIST=
# strict=只有名单里的发送者算（默认）
# off=这个群里谁发的都算（**显式**选择，不是默认行为）
SENDER_WHITELIST_MODE=strict

# ---- 抽取（原先后端管，现在归 bot）----
# rule=只跑规则（不调用模型）；llm=只跑模型；both=模型 + 规则交叉判断
EXTRACTOR=llm

# 模型拆成**提供商 + 模型名**两段配：
#   提供商决定用哪种协议、默认打到哪个地址（内置清单见 app/llm/providers.py）
#   模型名原样发给对方，不解析
# 两段分开之后，模型名里带斜杠也不会歧义。
LLM_PRIMARY_PROVIDER=deepseek
LLM_PRIMARY_MODEL=deepseek-chat

# 想用没内置的端点（自建 / 中转站 / 公司内网关）就填这三个，提供商名字随便起：
#   LLM_PRIMARY_PROVIDER=myproxy
#   LLM_PRIMARY_API_BASE=https://llm.corp.example.com/v1
#   LLM_PRIMARY_API_KEY=xxx
# 留空 = 用提供商注册表里的默认地址和默认 key 环境变量。
LLM_PRIMARY_API_BASE=
LLM_PRIMARY_API_KEY=
# 自定义端点走哪种协议：openai（默认）/ google
LLM_PRIMARY_API_KIND=

# 交叉验证：四个字段与主模型一一对应。提供商和模型名都留空 = 不做交叉验证。
# 换个提供商打同一个模型名也算不同的模型，交叉验证照样有意义。
LLM_SECONDARY_PROVIDER=
LLM_SECONDARY_MODEL=
LLM_SECONDARY_API_BASE=
LLM_SECONDARY_API_KEY=
LLM_SECONDARY_API_KIND=

LLM_TEMPERATURE=0
LLM_MAX_RETRIES=2
LLM_TIMEOUT=60
# 多模态：把图片喂给模型（官方通知经常把 DDL 写在图里）
VLM_ENABLED=false
VLM_MAX_IMAGES=3

# ---- digest（多用户之后是**按人**发的）----
DIGEST_ENABLED=true
DIGEST_TIME=21:30
DIGEST_TZ=Asia/Shanghai
# 留空（推荐）= 每个注册用户各收到一份**自己那份** digest，发到他的 QQ 上。
# 填了 = 只发这一个 QQ（行为和单租户时代一样，适合"实际上只有一个人用"的
#        部署）。注意收件人**必须是已注册用户** —— digest 的正文是从那个人的
#        通知里组装的，没有账号就没有正文可组装，这种情况会记 ERROR。
# ⚠️ QQ 机器人**不能主动给陌生人发消息**，只能发给好友或群里临时会话。
#    所以用户要先加机器人好友，否则 digest 会发失败（日志里有明确记录）。
DIGEST_TARGET_QQ=
# 自动 digest 每天最多尝试几次（成功与否由后端的 digest_log 判定，按用户各算）
DIGEST_MAX_AUTO_ATTEMPTS=3

# ---- 附件 ----
# 附件由 bot 下载字节再上传给后端（前端只跟后端打交道）
MEDIA_DOWNLOAD_ENABLED=true
MEDIA_MAX_BYTES=5242880

# ---- 阈值 ----
# 群静默多久算缺口（小时）
GAP_ALERT_HOURS=2
# 低于这个置信度的截止时间算"盲区"，也是 /add 回问的阈值
LOW_CONFIDENCE_THRESHOLD=0.6

# ---- 指令 ----
COMMAND_PREFIX=/
# 允许发指令的 QQ 号，格式 id:备注,id:备注（备注可省略）。留空=谁都不能发指令
COMMAND_WHITELIST=
# /add 需要二次确认时的挂起状态存活时间（秒）
PENDING_TTL_SECONDS=600
# /list 的「编号 → 通知 id」映射存活时间（秒）
LIST_STATE_TTL_SECONDS=1800

# ---- 崩溃恢复 ----
# 启动 / 重连后多久检查一次"后端里还有没有 pending 的消息要补处理"
RECOVERY_CHECK_INTERVAL=15

# ---- 日志 ----
LOG_LEVEL=INFO
# 消息日志里原文预览的最大长度
LOG_PREVIEW_CHARS=60

# ---- LLM 凭据 ----
# 只按「你实际用到的模型前缀」配一个即可，不用全配。
# 模型名写成 厂商/模型名，例如 LLM_PRIMARY_MODEL=deepseek/deepseek-chat。
#
# 内置的 OpenAI 兼容端点：
#   openai      → OPENAI_API_KEY        （另外 openrouter / groq / mistral / xai /
#   deepseek    → DEEPSEEK_API_KEY       moonshot / zhipu / dashscope / siliconflow /
#   moonshot    → MOONSHOT_API_KEY       volcengine 也都是这一类，变量名见
#   zhipu       → ZHIPUAI_API_KEY        app/llm/providers.py）
#   dashscope   → DASHSCOPE_API_KEY
#   siliconflow → SILICONFLOW_API_KEY
#   volcengine  → ARK_API_KEY
#   openrouter  → OPENROUTER_API_KEY
#   groq        → GROQ_API_KEY
#   mistral     → MISTRAL_API_KEY
#   xai         → XAI_API_KEY
#   ollama      → 不需要（本地 http://127.0.0.1:11434/v1）
#   vllm        → 不需要（本地 http://127.0.0.1:8000/v1）
#
# Google（两种都支持，用哪个都行）：
#   google/gemini-2.5-flash   → GEMINI_API_KEY（或 GOOGLE_API_KEY），走原生 generateContent
#   gemini-openai/...         → 同上，走 Google 官方的 OpenAI 兼容垫片
#
# 代理 / 自建网关：任何厂商的 base URL 都能覆盖，变量名是 {厂商名大写}_API_BASE：
#   DEEPSEEK_API_BASE=https://your-proxy.example.com/v1
# 没注册过的前缀也行，只要配上 {前缀大写}_API_BASE，就按 OpenAI 兼容处理：
#   MYPROXY_API_BASE=https://llm.corp.example.com/v1
#   MYPROXY_API_KEY=xxx
#   LLM_PRIMARY_MODEL=myproxy/qwen3-32b
#
# DEEPSEEK_API_KEY=sk-xxx
# OPENAI_API_KEY=sk-xxx
# GEMINI_API_KEY=xxx

# 模型自检：一条命令验证配置能不能用（建议第一次配好后跑一遍）
#   python -m app.tools.check_llm
